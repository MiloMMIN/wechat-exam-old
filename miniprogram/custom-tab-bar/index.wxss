.tab-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #e8eaed;
  padding-bottom: env(safe-area-inset-bottom);
  height: calc(108rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,.05);
  z-index: 99;
}

/* 左侧三个等分 */
.tab-group {
  flex: 1;
  display: flex;
}
.tab-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.tab-text { font-size: 20rpx; color: #9aa0a6; margin-top: 4rpx; }
.tab-item.active .tab-text { color: #07c160; font-weight: 500; }

.icon { width: 44rpx; height: 44rpx; position: relative; }

/* 题库：三本堆叠的书 */
.icon-books .book { position:absolute; border-radius:4rpx; border:2rpx solid #9aa0a6; }
.book-1 { width:14rpx; height:24rpx; left:6rpx; top:12rpx; transform:rotate(-8deg); }
.book-2 { width:14rpx; height:28rpx; left:16rpx; top:8rpx; }
.book-3 { width:14rpx; height:24rpx; right:6rpx; top:12rpx; transform:rotate(8deg); }
.tab-item.active .book-1 { border-color:#ff6b6b; }
.tab-item.active .book-2 { border-color:#07c160; }
.tab-item.active .book-3 { border-color:#339af0; }

/* 文档：折角纸 */
.icon-doc .doc-page {
  position:absolute; inset:4rpx 8rpx;
  border:2rpx solid #9aa0a6;
  border-radius:4rpx; border-top-right-radius:12rpx;
}
.icon-doc .doc-page::after {
  content:''; position:absolute; top:-2rpx; right:-2rpx;
  width:12rpx; height:12rpx;
  background:#fff;
  border-left:2rpx solid #9aa0a6; border-bottom:2rpx solid #9aa0a6;
  border-bottom-left-radius:6rpx;
}
.icon-doc .doc-lines {
  position:absolute; left:14rpx; right:14rpx; top:18rpx;
  height:2rpx; background:#9aa0a6;
  box-shadow:0 7rpx 0 #9aa0a6, 0 14rpx 0 #9aa0a6;
}
.tab-item.active .doc-page, .tab-item.active .doc-page::after { border-color:#07c160; }
.tab-item.active .doc-lines { background:#07c160; box-shadow:0 7rpx 0 #07c160, 0 14rpx 0 #07c160; }

/* 我的：人形 */
.icon-user .u-head {
  position:absolute; width:14rpx; height:14rpx;
  border-radius:50%; border:2rpx solid #9aa0a6;
  left:50%; top:4rpx; transform:translateX(-50%);
}
.icon-user .u-body {
  position:absolute; width:28rpx; height:14rpx;
  border:2rpx solid #9aa0a6; border-bottom:none;
  border-radius:20rpx 20rpx 0 0;
  left:50%; bottom:4rpx; transform:translateX(-50%);
}
.tab-item.active .u-head, .tab-item.active .u-body { border-color:#07c160; }

/* 右侧 + 浮动按钮 */
.fab {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.fab-btn {
  width: 96rpx; height: 96rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #b37feb, #5c7cfa);
  box-shadow: 0 8rpx 20rpx rgba(92,124,250,.45), 0 0 0 6rpx #fff;
  position: absolute;
  top: -20rpx;
  display: flex; align-items: center; justify-content: center;
}
.plus-v, .plus-h {
  position: absolute;
  background: #fff;
  border-radius: 3rpx;
}
.plus-v { width: 4rpx; height: 36rpx; }
.plus-h { width: 36rpx; height: 4rpx; }
