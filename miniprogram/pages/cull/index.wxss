.empty { text-align:center; color:#999; padding:120rpx 0; }
.tip { color:#999; font-size:24rpx; padding:8rpx 4rpx 20rpx; }
.cull-item {
  display:flex; align-items:center; gap:16rpx;
  background:#fff; border-radius:12rpx; padding:24rpx; margin-bottom:14rpx;
}
.cull-q { flex:1; font-size:28rpx; color:#333; line-height:1.5; }
.cull-restore {
  flex-shrink:0; font-size:26rpx; color:#07c160;
  padding:8rpx 20rpx; border:1rpx solid #07c160; border-radius:24rpx;
}
.clear-btn { margin-top:24rpx; background:#fff; color:#fa5151; }
