/* pages/search/index.wxss —— 智能搜题样式 */

.search-page {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 60rpx;
}

/* 顶部搜索条 */
.search-bar-wrap {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eceff1;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.search-input-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f1f3f5;
  border-radius: 36rpx;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #212529;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #ced4da;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.confirm-btn {
  font-size: 30rpx;
  font-weight: 600;
  color: #1971c2;
  padding: 8rpx 16rpx;
}

/* 题库控制条 */
.bank-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #eee;
}

.bank-picker {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #495057;
}

.bank-label {
  color: #868e96;
}

.bank-name-text {
  font-weight: 600;
  color: #1971c2;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bank-arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #868e96;
}

.ans-toggle-btn {
  font-size: 24rpx;
  color: #495057;
  padding: 6rpx 18rpx;
  background: #fff;
  border: 1rpx solid #dee2e6;
  border-radius: 20rpx;
}

/* 搜索历史 */
.history-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #495057;
}

.history-clear {
  font-size: 24rpx;
  color: #adb5bd;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  font-size: 24rpx;
  color: #495057;
  background: #f1f3f5;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 搜索结果 */
.result-container {
  padding: 20rpx 24rpx;
}

.result-summary {
  font-size: 24rpx;
  color: #868e96;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.search-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.q-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-no {
  font-size: 26rpx;
  font-weight: 700;
  color: #495057;
}

.meta-type {
  font-size: 22rpx;
  color: #868e96;
  background: #f1f3f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.match-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.tag-green {
  background: #ebfbee;
  color: #2b8a3e;
}

.tag-purple {
  background: #f3f0ff;
  color: #6741d9;
}

.tag-orange {
  background: #fff4e6;
  color: #d9480f;
}

/* 题干与高亮 */
.q-stem {
  font-size: 30rpx;
  line-height: 1.6;
  color: #212529;
  margin-bottom: 24rpx;
}

.hl-text {
  color: #d6336c;
  background: #fff0f6;
  font-weight: 700;
  border-bottom: 3rpx solid #f783ac;
  padding: 0 2rpx;
}

/* 选项列表 */
.opt-list {
  margin-bottom: 20rpx;
}

.opt {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: #495057;
  background: #fff;
  transition: all 0.2s;
}

.opt-hit {
  border-color: #74c0fc;
  background: #f8f9fa;
}

.opt.correct {
  border-color: #51cf66;
  background: #ebfbee;
  color: #2b8a3e;
}

.opt-label {
  flex-shrink: 0;
  width: 44rpx;
  font-weight: 700;
  color: #666;
}

.opt.correct .opt-label {
  color: #2b8a3e;
}

.opt-text {
  flex: 1;
}

.opt-mark {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #2b8a3e;
  margin-left: 12rpx;
}

/* 卡片底栏 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f3f5;
  margin-top: 12rpx;
}

.ans-badge {
  font-size: 26rpx;
  color: #495057;
}

.ans-label {
  color: #868e96;
}

.ans-value {
  color: #2b8a3e;
  font-weight: 700;
}

.ans-hide {
  color: #1971c2;
  font-size: 24rpx;
}

.action-btns {
  display: flex;
  gap: 20rpx;
}

.act-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6c757d;
  background: #f8f9fa;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.act-icon {
  font-size: 26rpx;
}

/* 空状态 */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #495057;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #adb5bd;
  text-align: center;
  line-height: 1.5;
}
