.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 28rpx;
}

.verdict {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #f0fbf4;
  border-radius: 8rpx;
  color: #07c160;
  font-size: 26rpx;
  line-height: 1.5;
}

.tool-row {
  display: flex;
  gap: 20rpx;
  margin: 0 4rpx 20rpx;
}
.tool {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #555;
}
.tool-icon { font-size: 30rpx; color: #f0a030; }
.tool.jump { flex: 1.2; }
.jump-input {
  width: 110rpx;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 26rpx;
}

.footer-bar button[disabled] { opacity: .4; }
