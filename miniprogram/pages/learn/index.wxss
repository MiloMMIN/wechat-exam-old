.empty { text-align: center; color: #999; padding: 120rpx 0; font-size: 28rpx; }

.seg-list { padding: 8rpx 0; }
.seg-item {
  display: flex; justify-content: space-between; align-items: center;
  background: #fff; padding: 30rpx 28rpx;
  border-radius: 12rpx; margin-bottom: 14rpx;
  font-size: 30rpx;
}
.seg-arrow { color: #bbb; font-size: 34rpx; }
.back-row { color: #07c160; font-size: 26rpx; padding: 10rpx 4rpx 20rpx; }

.verdict {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #f0fbf4;
  border-radius: 8rpx;
  color: #07c160;
  font-size: 26rpx;
  line-height: 1.5;
}

.tool-row { display: flex; gap: 14rpx; margin: 0 4rpx 20rpx; }
.tool {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 0;
}
.tool-text { font-size: 24rpx; color: #555; }

.note-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.note-ta {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.note-save { margin-top: 12rpx; background: #07c160; color: #fff; font-size: 28rpx; }

.footer-bar button[disabled] { opacity: .4; }
