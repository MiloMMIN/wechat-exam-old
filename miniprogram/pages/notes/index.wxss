.empty { text-align:center; color:#999; padding:80rpx 20rpx; font-size:26rpx; }
.add-box { background:#fff; border-radius:12rpx; padding:20rpx; margin-bottom:20rpx; }
.add-ta { width:100%; min-height:100rpx; font-size:28rpx; box-sizing:border-box; }
.add-btn { margin-top:12rpx; background:#07c160; color:#fff; font-size:28rpx; }

.note-item { background:#fff; border-radius:12rpx; padding:24rpx; margin-bottom:16rpx; }
.note-q { font-size:24rpx; color:#999; margin-bottom:8rpx; }
.note-text { font-size:28rpx; color:#222; line-height:1.6; white-space:pre-wrap; }
.note-foot { display:flex; justify-content:space-between; align-items:center; margin-top:14rpx; }
.note-time { font-size:22rpx; color:#bbb; }
.note-ops { display:flex; gap:24rpx; }
.note-op { font-size:24rpx; color:#07c160; }
.note-op.danger { color:#fa5151; }

.edit-ta { width:100%; min-height:120rpx; font-size:28rpx; background:#f6f7f9; border-radius:8rpx; padding:16rpx; box-sizing:border-box; }
.edit-row { display:flex; gap:20rpx; margin-top:12rpx; }
.edit-btn { flex:1; text-align:center; padding:12rpx 0; border-radius:8rpx; background:#f0f1f3; font-size:26rpx; color:#555; }
.edit-btn.primary { background:#07c160; color:#fff; }
