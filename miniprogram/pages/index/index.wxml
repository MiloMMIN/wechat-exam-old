<navigation-bar title="题库" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="container home">

  <!-- 题库切换 -->
  <picker range="{{bankList}}" range-key="name" value="{{bankIdx}}" bindchange="onBankChange">
    <view class="bank-switch">
      <text class="bank-name">{{bankName}}</text>
      <text class="bank-meta">{{total}} 题 · 点击切换题库 ›</text>
    </view>
  </picker>

  <!-- 4 快捷入口 -->
  <view class="quick-row">
    <view class="quick-item" bindtap="goMistake">
      <view class="quick-circle red"><text>✕</text></view>
      <text class="quick-text">错题 {{mistakeCount}}</text>
    </view>
    <view class="quick-item" bindtap="goFavorite">
      <view class="quick-circle amber"><text>★</text></view>
      <text class="quick-text">收藏 {{favCount}}</text>
    </view>
    <view class="quick-item" bindtap="goCull">
      <view class="quick-circle cyan"><text>✓</text></view>
      <text class="quick-text">斩题 {{cullCount}}</text>
    </view>
    <view class="quick-item" bindtap="goNotes">
      <view class="quick-circle purple"><text>✎</text></view>
      <text class="quick-text">笔记 {{noteCount}}</text>
    </view>
  </view>

  <!-- 题库练习 -->
  <view class="section-title">题库练习</view>
  <view class="grid">
    <view class="g-card g-green" bindtap="goLearn">
      <view class="g-title">顺序练习</view>
      <view class="g-sub">{{learnCursor}}/{{total}}</view>
    </view>
    <view class="g-card g-blue" bindtap="goRandom">
      <view class="g-title">随机练习</view>
      <view class="g-sub">打乱顺序</view>
    </view>
    <view class="g-card g-orange" bindtap="goExam">
      <view class="g-title">模拟考试</view>
      <view class="g-sub" wx:if="{{lastExam}}">上次 {{lastExam.score}} 分</view>
      <view class="g-sub" wx:else>仿真模拟</view>
    </view>
    <view class="g-card g-cyan" bindtap="goType">
      <view class="g-title">题型练习</view>
      <view class="g-sub">按选项数分类</view>
    </view>
    <view class="g-card g-purple" bindtap="goChapter">
      <view class="g-title">章节练习</view>
      <view class="g-sub">按题号分段</view>
    </view>
    <view class="g-card g-pink" bindtap="goSearch">
      <view class="g-title">搜题</view>
      <view class="g-sub">拼音/跨字检索</view>
    </view>
  </view>

  <!-- 功能 -->
  <view class="section-title">功能</view>
  <view class="feat-row">
    <view class="feat" bindtap="goBankDetail"><text class="feat-icon">📤</text><text class="feat-text">分享题库</text></view>
    <view class="feat" bindtap="goBankDetail"><text class="feat-icon">📋</text><text class="feat-text">题库详情</text></view>
  </view>
</view>

<!-- 右下角悬浮 +（只在本页出现） -->
<view class="fab-home" bindtap="goImport">
  <view class="fab-v"></view><view class="fab-h"></view>
</view>
