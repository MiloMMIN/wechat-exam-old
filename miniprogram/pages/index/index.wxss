.home { padding-top: 10rpx; }

.bank-switch {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}
.bank-name { font-size: 34rpx; font-weight: 700; color: #222; }
.bank-meta { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.quick-row {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.quick-item { display: flex; flex-direction: column; align-items: center; }
.quick-circle {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: #fff;
  margin-bottom: 8rpx;
}
.quick-circle.red { background: #ff6b6b; }
.quick-circle.amber { background: #f7b500; }
.quick-circle.cyan { background: #22b8cf; }
.quick-circle.purple { background: #9775fa; }
.quick-text { font-size: 24rpx; color: #555; }

.section-title {
  font-size: 26rpx; color: #999;
  margin: 8rpx 4rpx 16rpx;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.g-card {
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  min-height: 140rpx;
  display: flex; flex-direction: column; justify-content: space-between;
}
.g-green { background: linear-gradient(135deg, #d3f9d8, #b2f2bb); }
.g-blue { background: linear-gradient(135deg, #d0ebff, #a5d8ff); }
.g-orange { background: linear-gradient(135deg, #ffe8cc, #ffd8a8); }
.g-cyan { background: linear-gradient(135deg, #c5f6fa, #99e9f2); }
.g-purple { background: linear-gradient(135deg, #e5dbff, #d0bfff); }
.g-pink { background: linear-gradient(135deg, #fcc2d7, #eebefa); }
.g-title { font-size: 34rpx; font-weight: 700; color: #222; }
.g-sub { font-size: 24rpx; color: rgba(0,0,0,.55); margin-top: 8rpx; }

.feat-row { display: flex; gap: 32rpx; padding: 0 12rpx; }
.feat { display: flex; flex-direction: column; align-items: center; }
.feat-icon { font-size: 48rpx; }
.feat-text { font-size: 24rpx; color: #555; margin-top: 8rpx; }

/* 右下角悬浮 + 按钮，仅本页 */
.fab-home {
  position: fixed;
  right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 104rpx; height: 104rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #b37feb, #5c7cfa);
  box-shadow: 0 12rpx 28rpx rgba(92,124,250,.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 90;
}
.fab-v, .fab-h {
  position: absolute;
  background: #fff;
  border-radius: 3rpx;
}
.fab-v { width: 4rpx; height: 40rpx; }
.fab-h { width: 40rpx; height: 4rpx; }
