.home { padding-top: 10rpx; }

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.stat-row {
  display: flex;
  justify-content: space-around;
}
.stat-item { text-align: center; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #222; }
.stat-num.warn { color: #fa5151; }
.stat-num.accent { color: #07c160; }
.stat-label { font-size: 24rpx; color: #999; margin-top: 4rpx; }

.progress-track {
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  margin: 24rpx 0 12rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #07c160;
  border-radius: 6rpx;
  transition: width .3s;
}
.stat-tip { font-size: 24rpx; color: #999; text-align: center; }

.menu { display: flex; flex-direction: column; }
.menu-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.menu-btn::after { border: none; }
.menu-btn.primary { background: #07c160; }
.menu-btn.primary .menu-title, .menu-btn.primary .menu-sub { color: #fff; }
.menu-btn.warn-btn .menu-title { color: #fa5151; }
.menu-btn.ghost { background: transparent; }
.menu-btn.ghost .menu-title { color: #999; font-size: 26rpx; }

.menu-title { font-size: 32rpx; font-weight: 600; color: #222; }
.menu-sub { font-size: 24rpx; color: #999; margin-top: 6rpx; }

.exam-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}
.exam-box .menu-btn { margin-bottom: 0; padding: 20rpx; border-radius: 12rpx; }
.exam-title { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.exam-form { display: flex; gap: 32rpx; margin-bottom: 20rpx; }
.exam-field {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #555;
}
.exam-field input {
  flex: 1;
  background: #f5f6f8;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 30rpx;
}
