<navigation-bar title="自定义题库" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<view class="container">
  <view class="tip">粘贴文本，或上传 .txt / .md / .doc / .docx / .kbz 文件。</view>

  <view class="field">
    <text class="label">题库名</text>
    <input class="inp" placeholder="例如：期末复习" value="{{name}}" bindinput="onName" />
  </view>

  <view class="field">
    <view class="label-row">
      <text class="label">题目文本 <text wx:if="{{fileName}}" class="file-hint">({{fileName}})</text></text>
      <view class="mini-row">
        <view class="mini" bindtap="pasteFromClipboard">粘贴</view>
        <view class="mini" bindtap="pickFile">上传文件</view>
      </view>
    </view>
    <textarea
      class="ta {{expandText ? 'ta-full' : ''}}"
      placeholder="766.题干...\nA、选项A\nB、选项B\nC、选项C\nD、选项D\n【参考答案】A\n\n767.下一题..."
      value="{{raw}}"
      bindinput="onRaw"
      auto-height="{{expandText}}"
      maxlength="-1"
      show-confirm-bar="{{false}}"
    />
    <view class="expand-toggle" bindtap="toggleExpand" wx:if="{{raw.length > 400}}">
      {{expandText ? '收起 ▲' : '展开全部 ▼'}}
    </view>
  </view>

  <view class="row-btns">
    <button class="btn secondary" bindtap="doParse" disabled="{{parsing}}">{{parsing ? '解析中…' : '解析预览'}}</button>
    <button class="btn primary" bindtap="doImport" disabled="{{!parsedCount}}">导入（{{parsedCount}} 题）</button>
  </view>

  <view wx:if="{{warnings.length}}" class="warn-box">
    <view wx:for="{{warnings}}" wx:key="*this" class="warn-line">⚠ {{item}}</view>
  </view>

  <view wx:if="{{preview.length}}" class="preview">
    <view class="pv-title">预览（前 {{preview.length}} 题 / 共 {{parsedCount}}）</view>
    <view wx:for="{{preview}}" wx:key="index" class="pv-item">
      <view class="pv-q">{{item.q}}</view>
      <view class="pv-o">{{item.opts}}</view>
      <view class="pv-a">答案：{{item.a}}</view>
    </view>
  </view>

  <view class="ai-note" wx:if="{{!aiEnabled}}">AI 导题接口已预留（parseWithAI），接入后端后即可识别任意格式文本。</view>
</view>
